<view class="container">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress" style="width: {{(currentQuestion + 1) / questions.length * 100}}%"></view>
  </view>

  <view class="content">
    <!-- 玩家标识 -->
    <view class="player-badge">
      <view class="player-name">{{currentPlayer === 1 ? '❤️ 玩家1' : '💙 玩家2'}}</view>
      <view class="question-count">第 {{currentQuestion + 1}} / {{questions.length}} 题</view>
    </view>

    <!-- 问题卡片 -->
    <view class="question-card">
      <view class="question-text">{{questions[currentQuestion].question}}</view>
    </view>

    <!-- 答案选项 -->
    <view class="options">
      <view wx:for="{{questions[currentQuestion].options}}" 
            wx:key="index"
            class="option {{selectedAnswer === index ? 'selected' : ''}}"
            bindtap="selectAnswer"
            data-index="{{index}}">
        <view class="option-text">{{item}}</view>
      </view>
    </view>

    <!-- 提示信息 -->
    <view wx:if="{{selectedAnswer !== -1 && !showResult}}" class="hint">
      <text>点击"查看答案"继续</text>
    </view>

    <!-- 结果显示 -->
    <view wx:if="{{showResult}}" class="result-box {{selectedAnswer === questions[currentQuestion].correctAnswer ? 'correct' : 'wrong'}}">
      <view class="result-icon">{{selectedAnswer === questions[currentQuestion].correctAnswer ? '✅ 正确！' : '❌ 错误'}}</view>
      <view class="result-text">正确答案是：<text class="correct-answer">{{questions[currentQuestion].options[questions[currentQuestion].correctAnswer]}}</text></view>
      <view class="result-explanation">{{questions[currentQuestion].explanation}}</view>
    </view>

    <!-- 按钮组 -->
    <view class="button-group">
      <button wx:if="{{selectedAnswer !== -1 && !showResult}}" 
              class="btn btn-primary" 
              bindtap="showAnswer">
        查看答案
      </button>
      
      <button wx:if="{{showResult && currentQuestion < questions.length - 1}}" 
              class="btn btn-primary" 
              bindtap="nextQuestion">
        下一题
      </button>
      
      <button wx:if="{{showResult && currentQuestion === questions.length - 1}}" 
              class="btn btn-primary" 
              bindtap="goToResult">
        查看成绩
      </button>

      <button wx:if="{{selectedAnswer === -1}}" 
              class="btn btn-disabled" 
              disabled>
        请先选择答案
      </button>
    </view>
  </view>
</view>